# Set these in the backend process environment; never commit real credentials.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_COMPONENT_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Optional frontend server proxy target
BACKEND_URL=http://127.0.0.1:8000

# The agent panel streams server-sent events straight from the backend, because
# the Next dev proxy buffers them. Override only if the backend is not on
# 127.0.0.1:8000; it must go in frontend/.env.local, since Next does not read
# this file. Set it empty to force everything back through the proxy.
# NEXT_PUBLIC_AGENT_ORIGIN=http://127.0.0.1:8000
